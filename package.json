{
  "name": "dori-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "node --test \"tests/*.test.ts\"",
    "test:my-world:emulator:run": "node --import ./tests/emulator/register-alias.mjs --test --test-concurrency=1 \"tests/emulator/*.test.ts\"",
    "test:my-world:emulator": "firebase emulators:exec --only auth,firestore --project demo-illo-myworld \"npm run test:my-world:emulator:run\"",
    "test:reward:edge:run": "node --import ./tests/emulator/register-alias.mjs tests/edge/run-edge-e2e.mjs",
    "test:reward:edge": "firebase emulators:exec --only auth,firestore --project demo-illo-myworld \"npm run test:reward:edge:run\"",
    "test:reward:local-stack": "npm run test:reward:edge",
    "build:emu": "node -e \"process.env.NEXT_PUBLIC_USE_FIREBASE_EMULATOR='true';require('child_process').execSync('npx next build',{stdio:'inherit'})\"",
    "test:reward:ui:run": "node tests/edge/run-ui-e2e.mjs",
    "test:reward:ui": "firebase emulators:exec --only auth,firestore --project demo-illo-myworld \"npm run test:reward:ui:run\"",
    "dev:edge": "wrangler pages dev out --port 8788 --compatibility-date=2024-05-18 --binding REWARD_ENV=emulator --binding FIREBASE_PROJECT_ID=demo-illo-myworld --binding FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 --binding FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099",
    "test:my-world:all": "npm test && npm run test:my-world:emulator",
    "lint": "eslint",
    "sync:data": "node scripts/worldmap/sync-country-data.mjs",
    "verify:data": "node --import ./tests/worldmap/register.mjs --test tests/worldmap/data.test.ts",
    "test:worldmap": "node --import ./tests/worldmap/register.mjs --test \"tests/worldmap/*.test.ts\"",
    "test:e2e": "playwright test",
    "audit:worldmap:ko": "node --import ./tests/worldmap/register.mjs scripts/worldmap/audit-korean.mjs",
    "audit:worldmap:seo": "node --import ./tests/worldmap/register.mjs scripts/worldmap/audit-seo.mjs",
    "build:worldmap:otherland": "node scripts/worldmap/build-other-land.mjs"
  },
  "dependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "firebase": "^12.9.0",
    "framer-motion": "^12.29.2",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.562.0",
    "next": "^14.2.4",
    "next-mdx-remote": "^5.0.0",
    "next-themes": "^0.4.6",
    "quill": "^2.0.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-slug": "^6.0.0",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-html": "^16.0.1",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "maplibre-gl": "^5.9.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.15.1",
    "@tailwindcss/postcss": "^4.1.17",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.60.0",
    "@playwright/test": "^1.49.1"
  }
}
